---
import Base from './Base.astro'
import { sections } from '@/data/site'

interface Props { title: string; intro?: string; section?: string; description?: string; image?: string; wide?: boolean }
const { title, intro, section, description, image, wide = false } = Astro.props
---
<Base title={title} description={description ?? intro} image={image}>
  <div class="border-b border-slate-200 bg-brand-50/60">
    <div class="container-page py-10 sm:py-14">
      {section && sections[section] && (
        <nav aria-label="Fil d’Ariane" class="mb-3 text-sm text-slate-600">
          <a href="/" class="hover:text-slate-900">Accueil</a>
          <span class="mx-1.5 text-slate-400">/</span>
          <a href={`/${section}`} class="hover:text-slate-900">{sections[section]}</a>
        </nav>
      )}
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{title}</h1>
      {intro && <p class="mt-3 max-w-2xl text-lg text-slate-600">{intro}</p>}
      <slot name="header" />
    </div>
  </div>
  <div class:list={['py-10 sm:py-14', wide ? 'container-page' : 'mx-auto w-full max-w-3xl px-4 sm:px-6 lg:px-8']}>
    <slot />
  </div>
</Base>
