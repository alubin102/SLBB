---
import Page from '@/layouts/Page.astro'
import Icon from '@/components/Icon.astro'
import { club, gymnases, reseaux } from '@/data/site'
---
<Page title="Contact" intro="Une question sur les créneaux, les inscriptions ou un partenariat ? Écrivez-nous." wide>
  <div class="grid gap-8 lg:grid-cols-2">
    <div class="space-y-4">
      <a href={`mailto:${club.email}`} class="card flex items-center gap-4 p-5 hover:border-brand-300">
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-700"><Icon name="mail" class="h-6 w-6" /></span>
        <span class="min-w-0"><span class="block text-sm text-slate-600">E-mail</span><span class="block break-words font-semibold">{club.email}</span></span>
      </a>
      <a href={`tel:${club.telephone.replace(/\s/g, '')}`} class="card flex items-center gap-4 p-5 hover:border-brand-300">
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-700"><Icon name="phone" class="h-6 w-6" /></span>
        <span><span class="block text-sm text-slate-600">Téléphone</span><span class="font-semibold">{club.telephone}</span></span>
      </a>
      <div class="card p-5">
        <p class="text-sm text-slate-600">Réseaux sociaux</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {reseaux.map((r) => (
            <li><a href={r.url} class="inline-flex items-center gap-2 min-h-11 rounded-lg border border-slate-300 px-3 py-2 text-sm font-semibold hover:border-brand-500"><Icon name={r.icon} />{r.nom}</a></li>
          ))}
        </ul>
      </div>
      <p class="text-sm text-slate-600">Siège social : {club.siege}</p>
    </div>

    <div>
      <h2 class="text-xl font-bold tracking-tight">Où nous trouver</h2>
      <ul class="mt-4 space-y-4">
        {gymnases.map((g) => (
          <li class="card p-5">
            <p class="font-semibold">{g.nom}</p>
            <p class="text-slate-700">{g.adresse}, {g.ville}</p>
            {g.note && <p class="text-sm text-slate-600">{g.note}</p>}
            <a href={g.maps} class="mt-1 inline-flex min-h-11 items-center gap-1 text-sm font-semibold text-brand-700">Itinéraire <Icon name="external" class="h-4 w-4" /></a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Page>
