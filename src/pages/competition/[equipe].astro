---
import Page from '@/layouts/Page.astro'
import MatchRow from '@/components/MatchRow.astro'
import Standings from '@/components/Standings.astro'
import Icon from '@/components/Icon.astro'
import { equipes, slugEquipe, interclubs } from '@/lib/interclubs'
import { dateLongue } from '@/lib/format'

export function getStaticPaths() {
  return equipes.map((equipe) => ({ params: { equipe: slugEquipe(equipe) }, props: { equipe } }))
}
const { equipe: e } = Astro.props
const joues = e.rencontres.filter((m) => m.score)
const aVenir = e.rencontres.filter((m) => !m.score)
---
<Page title={`Équipe ${e.numero} — ${e.niveau}`} section="competition" intro={e.competition} wide>
  <div class="grid gap-12 lg:grid-cols-5">
    <div class="space-y-12 lg:col-span-3">
      <section>
        <h2 class="text-xl font-bold tracking-tight">Classement · {e.poule}</h2>
        <div class="mt-4"><Standings classement={e.classement} sigle={e.sigle} /></div>
      </section>
      <section>
        <h2 class="text-xl font-bold tracking-tight">Calendrier</h2>
        <div class="mt-2 divide-y divide-slate-100">{aVenir.map((m) => <MatchRow match={m} sigle={e.sigle} />)}</div>
        {aVenir.length === 0 && <p class="mt-2 text-slate-600">Plus de rencontre à venir.</p>}
      </section>
      <section>
        <h2 class="text-xl font-bold tracking-tight">Résultats</h2>
        <div class="mt-2 divide-y divide-slate-100">{joues.map((m) => <MatchRow match={m} sigle={e.sigle} />)}</div>
        {joues.length === 0 && <p class="mt-2 text-slate-600">Aucune rencontre jouée pour le moment.</p>}
      </section>
    </div>

    <aside class="lg:col-span-2">
      <h2 class="text-xl font-bold tracking-tight">Effectif</h2>
      <ul class="mt-4 divide-y divide-slate-100 rounded-2xl border border-slate-200 px-4">
        {e.joueurs.map((j) => (
          <li class="flex items-center justify-between gap-3 py-3">
            <span class="font-medium">{j.nom}</span>
            <span class="flex gap-1" title="Classements simple / double / mixte">
              {j.classements.map((c) => <span class="rounded bg-slate-100 px-1.5 py-0.5 text-xs font-semibold text-slate-700">{c}</span>)}
            </span>
          </li>
        ))}
      </ul>
      <p class="mt-2 text-xs text-slate-500">Classements : simple, double, mixte.</p>
      <a href={e.url} class="btn-secondary mt-6 text-sm">Fiche complète sur ICBaD <Icon name="external" class="h-4 w-4" /></a>
    </aside>
  </div>
  <p class="mt-12 text-sm text-slate-500">Données ICBaD (FFBaD), mises à jour le {dateLongue(interclubs.majLe)}.</p>
</Page>
