---
import Base from '@/layouts/Base.astro'
import Hero from '@/components/Hero.astro'
import Icon from '@/components/Icon.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import NewsCard from '@/components/NewsCard.astro'
import EventItem from '@/components/EventItem.astro'
import MatchRow from '@/components/MatchRow.astro'
import { actualites, evenements } from '@/lib/content'
import { equipes, slugEquipe, derniersResultats, prochainesRencontres } from '@/lib/interclubs'
import { gymnases } from '@/data/site'
import partenaires from '@/data/partenaires.json'

const news = (await actualites()).slice(0, 3)
const { aVenir } = await evenements()
const tournoi = aVenir.find((e) => /tournoi/i.test(e.data.title)) ?? aVenir[0]
const resultats = derniersResultats(3)
const rencontres = prochainesRencontres(3)

const acces = [
  { label: 'Horaires', detail: 'Créneaux jeunes et adultes', href: '/infos-pratiques/horaires', icon: 'clock' },
  { label: 'Gymnases', detail: 'Adresses et itinéraires', href: '/infos-pratiques/gymnases', icon: 'pin' },
  { label: 'Tarifs', detail: 'Licence et aides', href: '/inscription#tarifs', icon: 'euro' },
  { label: 'Contact', detail: 'Nous écrire', href: '/contact', icon: 'mail' },
]
---
<Base>
  <Hero
    prochain={tournoi && { title: tournoi.data.title, href: `/agenda/${tournoi.id}`, start: tournoi.data.start, end: tournoi.data.end }}
    equipeUne={equipes[0]?.niveau}
  />

  <!-- Accès rapides -->
  <section aria-label="Accès rapides" class="container-page -mt-px py-6 sm:py-10">
    <ul class="grid grid-cols-2 gap-3 lg:grid-cols-4">
      {acces.map((a) => (
        <li>
          <a href={a.href} class="card group flex h-full items-center gap-4 p-4 transition hover:border-brand-300 hover:shadow-sm sm:p-5">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-700"><Icon name={a.icon} class="h-6 w-6" /></span>
            <span class="min-w-0">
              <span class="block font-semibold group-hover:text-brand-700">{a.label}</span>
              <span class="hidden text-sm text-slate-600 sm:block">{a.detail}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- À la une -->
  <section class="container-page py-6 sm:py-10">
    <SectionHeading title="À la une" href="/actualites" link="Toutes les actualités" />
    <!-- Mobile : carrousel à faire défiler au doigt, pour ne pas empiler trois grandes cartes -->
    <ul class="-mx-4 mt-5 flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-px-4 px-4 pb-2 [scrollbar-width:none] sm:mx-0 sm:mt-6 sm:grid sm:grid-cols-2 sm:gap-6 sm:overflow-visible sm:p-0 lg:grid-cols-3 [&::-webkit-scrollbar]:hidden">
      {news.map((n) => <li class="w-[82%] shrink-0 snap-start sm:w-auto"><NewsCard href={`/actualites/${n.id}`} title={n.data.title} date={n.data.date} image={n.data.image} /></li>)}
    </ul>
  </section>

  <!-- Agenda + compétition -->
  <section class="mt-4 bg-slate-50 py-10 sm:mt-0 sm:py-14">
    <div class="container-page grid gap-10 sm:gap-12 lg:grid-cols-2">
      <div class="min-w-0">
        <SectionHeading title="Agenda" href="/agenda" link="Tout l’agenda" />
        <div class="mt-4 divide-y divide-slate-200">
          {aVenir.slice(0, 4).map((e) => <EventItem href={`/agenda/${e.id}`} title={e.data.title} start={e.data.start} end={e.data.end} lieu={e.data.lieu} />)}
        </div>
      </div>
      <div class="min-w-0">
        <SectionHeading title="Interclubs" href="/competition" link="Classements" />
        <ul class="mt-5 flex flex-wrap gap-2">
          {equipes.map((e) => (
            <li><a href={`/competition/${slugEquipe(e)}`} class="inline-flex items-center gap-2 rounded-full border border-slate-300 bg-white px-3 py-1.5 text-sm font-semibold hover:border-brand-500">
              Équipe {e.numero}<span class="rounded bg-slate-900 px-1.5 py-0.5 text-xs text-white">{e.niveau}</span>
            </a></li>
          ))}
        </ul>
        {resultats.length > 0 && (
          <>
            <h3 class="mt-6 text-sm font-semibold uppercase tracking-wide text-slate-500">Derniers résultats</h3>
            <div class="divide-y divide-slate-200">{resultats.map((m) => <MatchRow match={m} sigle={m.equipe.sigle} niveau={m.equipe.niveau} />)}</div>
          </>
        )}
        {rencontres.length > 0 && (
          <>
            <h3 class="mt-6 text-sm font-semibold uppercase tracking-wide text-slate-500">Prochaines rencontres</h3>
            <div class="divide-y divide-slate-200">{rencontres.map((m) => <MatchRow match={m} sigle={m.equipe.sigle} niveau={m.equipe.niveau} />)}</div>
          </>
        )}
      </div>
    </div>
  </section>

  <!-- Où jouer -->
  <section class="container-page py-10 sm:py-14">
    <SectionHeading title="Où jouer" href="/infos-pratiques/gymnases" link="Plans d’accès" />
    <ul class="mt-5 grid gap-3 sm:mt-6 sm:gap-6 md:grid-cols-2">
      {gymnases.filter((g) => g.terrains).map((g) => (
        <li class="card flex items-start justify-between gap-4 p-5 sm:p-6">
          <div>
            <h3 class="text-lg font-bold">{g.nom}</h3>
            <p class="mt-1 text-slate-700">{g.adresse}<br />{g.ville}</p>
            <a href={g.maps} class="mt-1 inline-flex min-h-11 items-center gap-1 text-sm font-semibold text-brand-700">Itinéraire <Icon name="external" class="h-4 w-4" /></a>
          </div>
          <p class="shrink-0 text-right"><span class="block text-4xl font-extrabold tracking-tight text-brand-700">{g.terrains}</span><span class="text-sm text-slate-600">terrains</span></p>
        </li>
      ))}
    </ul>
  </section>

  <!-- École de badminton -->
  <section class="container-page">
    <div class="overflow-hidden rounded-3xl bg-slate-950 text-white md:grid md:grid-cols-5">
      <div class="p-6 sm:p-12 md:col-span-3">
        <p class="text-sm font-semibold uppercase tracking-wide text-brand-300">Dispositif jeunes</p>
        <h2 class="mt-2 text-2xl font-bold tracking-tight sm:text-3xl">École Française de Badminton 3 étoiles</h2>
        <p class="mt-4 max-w-xl text-slate-300">
          Un accueil de qualité pour les jeunes de 5 à 17 ans, dans des créneaux spécifiques par âge et par niveau,
          encadrés par notre éducateur diplômé d’État et des bénévoles impliqués.
        </p>
        <a href="/jeunes/ecole-de-badminton" class="mt-6 inline-flex items-center gap-2 rounded-xl bg-white px-5 py-3 font-semibold text-slate-950 hover:bg-slate-100">
          Découvrir l’école <Icon name="arrow" />
        </a>
      </div>
      <div class="flex items-center justify-center bg-white/5 p-6 sm:p-8 md:col-span-2">
        <img src="/media/kcupload/EFB_3Etoiles_Saison_2526.png" alt="Label École Française de Badminton 3 étoiles, saison 2025-2026" loading="lazy" class="max-h-36 w-auto sm:max-h-56" />
      </div>
    </div>
  </section>

  <!-- Partenaires -->
  <section class="container-page py-10 sm:py-14">
    <SectionHeading title="Ils nous soutiennent" href="/partenaires" link="Tous les partenaires" />
    <ul class="mt-6 grid grid-cols-3 items-center gap-x-6 gap-y-8 sm:grid-cols-4 lg:grid-cols-7">
      {partenaires.filter((p) => p.logo).map((p) => (
        <li class="flex h-14 items-center justify-center">
          <img src={p.logo} alt={p.name} loading="lazy" class="max-h-14 max-w-full object-contain opacity-80 grayscale transition hover:opacity-100 hover:grayscale-0" />
        </li>
      ))}
    </ul>
  </section>
</Base>
