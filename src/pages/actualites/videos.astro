---
import Page from '@/layouts/Page.astro'
import videos from '@/data/videos.json'
import { dateLongue } from '@/lib/format'
---
<Page title="Vidéos" section="actualites" wide>
  <ul class="grid gap-8 sm:grid-cols-2">
    {videos.map((v) => (
      <li>
        <video controls preload="none" poster={v.poster} class="aspect-video w-full rounded-2xl bg-slate-900"><source src={v.src} type="video/mp4" /></video>
        <h2 class="mt-3 font-semibold">{v.title || v.album}</h2>
        <p class="text-sm text-slate-600">{v.album}{v.date && ` · ${dateLongue(v.date)}`}</p>
      </li>
    ))}
  </ul>
  <p class="mt-10 text-slate-600">Retrouvez aussi le club sur <a href="https://www.youtube.com/@SullylesBordesBadminton" class="font-semibold text-brand-700 underline">YouTube</a>.</p>
</Page>
