---
import { navigation, club } from '@/data/site'
import Icon from './Icon.astro'
const path = Astro.url.pathname
const active = (href: string) => path === href || path.startsWith(href + '/')
---
<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex shrink-0 items-center gap-3" aria-label={`${club.nom} — accueil`}>
      <img src="/logo.png" alt="" width="44" height="44" class="h-11 w-11" />
      <span class="text-sm font-bold leading-tight tracking-tight sm:text-base">
        Sully Les Bordes<span class="block text-brand-700">Badminton</span>
      </span>
    </a>

    <nav class="hidden lg:block" aria-label="Navigation principale">
      <ul class="flex items-center gap-1">
        {navigation.map((entry) => (
          <li class="group relative">
            <a
              href={entry.href}
              aria-current={active(entry.href) ? 'true' : undefined}
              class:list={[
                'flex items-center gap-1 rounded-lg px-3 py-2 text-sm font-medium transition hover:bg-slate-100',
                active(entry.href) ? 'text-brand-700' : 'text-slate-700',
              ]}
            >
              {entry.label}
              <Icon name="chevron" class="h-3.5 w-3.5 text-slate-400" />
            </a>
            <div class="invisible absolute left-0 top-full z-10 w-64 pt-2 opacity-0 transition group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
              <ul class="rounded-xl border border-slate-200 bg-white p-2 shadow-lg">
                {entry.items.map((item) => (
                  <li>
                    <a href={item.href} class="block rounded-lg px-3 py-2 text-sm text-slate-700 hover:bg-brand-50 hover:text-brand-800">
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href="/inscription" class="hidden rounded-lg bg-brand-700 px-4 py-2 text-sm font-semibold text-white transition hover:bg-brand-800 sm:inline-flex">
        S’inscrire
      </a>
      <button
        type="button"
        id="menu-toggle"
        class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-slate-700 hover:bg-slate-100 lg:hidden"
        aria-controls="menu-mobile"
        aria-expanded="false"
      >
        <span class="sr-only">Menu</span>
        <span data-open><Icon name="menu" class="h-6 w-6" /></span>
        <span data-close hidden><Icon name="close" class="h-6 w-6" /></span>
      </button>
    </div>
  </div>

  <nav id="menu-mobile" hidden class="max-h-[calc(100dvh-4rem)] overflow-y-auto border-t border-slate-200 bg-white lg:hidden" aria-label="Navigation mobile">
    <div class="container-page py-4">
      <a href="/inscription" class="btn-primary w-full sm:hidden">S’inscrire</a>
      <ul class="mt-2 divide-y divide-slate-100">
        {navigation.map((entry) => (
          <li>
            <details class="group" open={active(entry.href)}>
              <summary class="flex cursor-pointer list-none items-center justify-between py-3.5 text-base font-semibold [&::-webkit-details-marker]:hidden">
                {entry.label}
                <Icon name="chevron" class="h-5 w-5 text-slate-400 transition group-open:rotate-180" />
              </summary>
              <ul class="pb-3">
                {entry.items.map((item) => (
                  <li><a href={item.href} class="block rounded-lg px-3 py-2.5 text-slate-700 hover:bg-brand-50">{item.label}</a></li>
                ))}
              </ul>
            </details>
          </li>
        ))}
        <li><a href="/contact" class="block py-3.5 text-base font-semibold">Contact</a></li>
      </ul>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle')!
  const menu = document.getElementById('menu-mobile')!
  toggle.addEventListener('click', () => {
    const open = menu.hidden
    menu.hidden = !open
    toggle.setAttribute('aria-expanded', String(open))
    toggle.querySelector<HTMLElement>('[data-open]')!.hidden = open
    toggle.querySelector<HTMLElement>('[data-close]')!.hidden = !open
  })
</script>
