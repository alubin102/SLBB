---
interface Props { title: string; href?: string; link?: string; id?: string }
const { title, href, link, id } = Astro.props
---
<div class="flex items-end justify-between gap-4">
  <h2 id={id} class="text-2xl font-bold tracking-tight sm:text-3xl">{title}</h2>
  {href && <a href={href} class="shrink-0 text-sm font-semibold text-brand-700 hover:text-brand-900">{link} →</a>}
</div>
