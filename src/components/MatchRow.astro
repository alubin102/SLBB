---
import { dateCourte, heure } from '@/lib/format'
interface Props { match: any; sigle: string; niveau?: string }
const { match: m, sigle, niveau } = Astro.props
const s = m.score
const nous = s && (m.aDomicile ? s.domicile : s.exterieur)
const eux = s && (m.aDomicile ? s.exterieur : s.domicile)
const issue = !s ? null : nous > eux ? 'V' : nous < eux ? 'D' : 'N'
const couleur = { V: 'bg-emerald-100 text-emerald-800', D: 'bg-rose-100 text-rose-800', N: 'bg-slate-200 text-slate-700' }
const libelle = { V: 'Victoire', D: 'Défaite', N: 'Nul' }
const nom = (e: any) => (e.sigle === sigle ? 'SLBB' : e.nom)
---
<a href={m.url} class="flex items-center gap-3 py-3 text-sm hover:bg-slate-50 sm:gap-4">
  <span class="w-[5.5rem] shrink-0 text-slate-600 sm:w-28">
    <span class="block whitespace-nowrap font-medium text-slate-900">{dateCourte(m.date)}</span>
    <span class="text-xs">{niveau ? `${niveau} · ` : ''}{m.journee}{!s && !m.date.endsWith('T00:00') && ` · ${heure(m.date)}`}</span>
  </span>
  <span class="min-w-0 flex-1">
    <span class:list={['block sm:truncate', m.aDomicile && 'font-semibold']}>{nom(m.domicile)}</span>
    <span class:list={['block sm:truncate', !m.aDomicile && 'font-semibold']}>{nom(m.exterieur)}</span>
  </span>
  {s ? (
    <span class="flex shrink-0 items-center gap-2">
      <span class="text-right font-semibold tabular-nums"><span class="block">{s.domicile}</span><span class="block">{s.exterieur}</span></span>
      <span class:list={['flex h-7 w-7 items-center justify-center rounded-md text-xs font-bold', couleur[issue!]]} title={libelle[issue!]}>{issue}<span class="sr-only"> — {libelle[issue!]}</span></span>
    </span>
  ) : (
    <span class="shrink-0 rounded-md bg-slate-100 px-2 py-1 text-xs font-medium text-slate-700">{m.aDomicile ? 'Domicile' : 'Extérieur'}</span>
  )}
</a>
