---
import { dateLongue } from '@/lib/format'
interface Props { href: string; title: string; date: Date; image?: string }
const { href, title, date, image } = Astro.props
---
<a href={href} class="card group flex h-full flex-col overflow-hidden transition hover:border-slate-300 hover:shadow-md">
  <div class="aspect-[16/10] overflow-hidden bg-slate-100">
    {image
      ? <img src={image} alt="" loading="lazy" class="h-full w-full object-cover transition duration-300 group-hover:scale-105" />
      : <div class="flex h-full items-center justify-center bg-brand-50"><img src="/logo.png" alt="" class="h-20 w-20 opacity-60" /></div>}
  </div>
  <div class="flex flex-1 flex-col p-5">
    <time datetime={date.toISOString()} class="text-sm text-slate-500">{dateLongue(date)}</time>
    <h3 class="mt-1 text-lg font-semibold leading-snug group-hover:text-brand-700">{title}</h3>
  </div>
</a>
