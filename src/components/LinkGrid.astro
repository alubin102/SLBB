---
import Icon from './Icon.astro'
interface Props { items: { label: string; href: string; description?: string }[] }
const { items } = Astro.props
---
<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {items.map((i) => (
    <li>
      <a href={i.href} class="card group flex h-full items-center justify-between gap-4 p-5 transition hover:border-brand-300 hover:shadow-sm">
        <span>
          <span class="block font-semibold group-hover:text-brand-700">{i.label}</span>
          {i.description && <span class="mt-1 block text-sm text-slate-600">{i.description}</span>}
        </span>
        <Icon name="arrow" class="h-5 w-5 shrink-0 text-slate-400 group-hover:text-brand-700" />
      </a>
    </li>
  ))}
</ul>
