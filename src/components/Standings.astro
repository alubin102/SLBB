---
interface Props { classement: any[]; sigle: string }
const { classement, sigle } = Astro.props
---
<div class="overflow-x-auto">
  <table class="w-full text-left text-sm">
    <thead class="text-xs uppercase tracking-wide text-slate-500">
      <tr class="border-b border-slate-200">
        <th scope="col" class="py-2 pr-2 font-medium">#</th>
        <th scope="col" class="py-2 pr-2 font-medium">Équipe</th>
        <th scope="col" class="px-1.5 py-2 text-center font-medium sm:px-2"><abbr title="Jouées">J</abbr></th>
        <th scope="col" class="px-1.5 py-2 text-center font-medium sm:px-2"><abbr title="Gagnées">G</abbr></th>
        <th scope="col" class="px-1.5 py-2 text-center font-medium sm:px-2"><abbr title="Nulles">N</abbr></th>
        <th scope="col" class="px-1.5 py-2 text-center font-medium sm:px-2"><abbr title="Perdues">P</abbr></th>
        <th scope="col" class="py-2 pl-2 text-right font-medium"><abbr title="Points">Pts</abbr></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      {classement.map((l) => (
        <tr class:list={[l.sigle === sigle && 'bg-brand-50 font-semibold']}>
          <td class="py-2.5 pl-1 pr-2 tabular-nums">{l.rang}</td>
          <th scope="row" class="py-2.5 pr-2 font-[inherit]">{l.nom} <span class="hidden whitespace-nowrap text-xs font-normal text-slate-500 sm:inline">{l.sigle}</span></th>
          <td class="px-1.5 py-2.5 text-center tabular-nums sm:px-2">{l.joues}</td>
          <td class="px-1.5 py-2.5 text-center tabular-nums sm:px-2">{l.gagnes}</td>
          <td class="px-1.5 py-2.5 text-center tabular-nums sm:px-2">{l.nuls}</td>
          <td class="px-1.5 py-2.5 text-center tabular-nums sm:px-2">{l.perdus}</td>
          <td class="py-2.5 pl-2 pr-1 text-right font-bold tabular-nums">{l.points}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
